<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_adhan_lockscreen"
    android:keepScreenOn="true"
    android:padding="24dp">

    <!-- Top Islamic Header -->
    <LinearLayout
        android:id="@+id/header_layout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentTop="true"
        android:layout_marginTop="32dp"
        android:gravity="center"
        android:orientation="vertical">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="بِسْمِ اللَّـهِ الرَّحْمَـٰنِ الرَّحِيمِ"
            android:textColor="#B3D4AF37"
            android:textSize="15sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tv_takbeer"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="اللهُ أَكْبَرُ • اللهُ أَكْبَرُ"
            android:textColor="#FFFFFF"
            android:textSize="22sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Center Content: Mosque Icon, Prayer Name, Time -->
    <LinearLayout
        android:id="@+id/center_layout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_centerInParent="true"
        android:gravity="center"
        android:orientation="vertical">

        <!-- Mosque Glowing Icon -->
        <FrameLayout
            android:id="@+id/icon_container"
            android:layout_width="120dp"
            android:layout_height="120dp"
            android:background="@drawable/bg_mosque_circle">

            <ImageView
                android:id="@+id/iv_mosque"
                android:layout_width="64dp"
                android:layout_height="64dp"
                android:layout_gravity="center"
                android:contentDescription="Mosque"
                android:src="@drawable/ic_mosque_white" />
        </FrameLayout>

        <!-- Prayer Call Announcement -->
        <TextView
            android:id="@+id/tv_athan_call"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="حان الآن موعد أذان"
            android:textColor="#D0FFFFFF"
            android:textSize="18sp" />

        <!-- Prayer Name (Big) -->
        <TextView
            android:id="@+id/tv_prayer_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="صلاة المغرب"
            android:textColor="#FFD4AF37"
            android:textSize="36sp"
            android:textStyle="bold" />

        <!-- Current Prayer Time -->
        <TextView
            android:id="@+id/tv_prayer_time"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="06:15 م"
            android:textColor="#FFFFFF"
            android:textSize="24sp"
            android:textStyle="bold" />

        <!-- Audio Indicator -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:gravity="center"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tv_playing_status"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="الأذان يرفع الآن بصوت المؤذن..."
                android:textColor="#B3FFFFFF"
                android:textSize="14sp" />
        </LinearLayout>
    </LinearLayout>

    <!-- Bottom Action Controls -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:layout_marginBottom="24dp"
        android:gravity="center"
        android:orientation="vertical">

        <!-- Stop Adhan Button -->
        <Button
            android:id="@+id/btn_stop_adhan"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginStart="24dp"
            android:layout_marginEnd="24dp"
            android:background="@drawable/btn_stop_adhan"
            android:text="إيقاف الأذان ⏹"
            android:textColor="#FFFFFF"
            android:textSize="18sp"
            android:textStyle="bold" />

        <!-- Unlock to stop hint (requested by user) -->
        <TextView
            android:id="@+id/tv_unlock_hint"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:text="أو افتح قفل الهاتف لإيقاف الأذان تلقائياً"
            android:textColor="#80FFFFFF"
            android:textSize="13sp" />
    </LinearLayout>

</RelativeLayout>
