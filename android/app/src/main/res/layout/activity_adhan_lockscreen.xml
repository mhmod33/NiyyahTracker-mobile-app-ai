<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_adhan_lockscreen"
    android:keepScreenOn="true">

    <!-- Radial glow behind the glass card -->
    <View
        android:layout_width="360dp"
        android:layout_height="360dp"
        android:layout_gravity="center"
        android:background="@drawable/bg_adhan_glow" />

    <!-- Basmala — top, very low contrast -->
    <TextView
        android:id="@+id/tv_basmala"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|center_horizontal"
        android:layout_marginTop="72dp"
        android:fontFamily="@font/ibm_plex_sans_arabic"
        android:letterSpacing="0.06"
        android:text="بِسْمِ اللَّـهِ الرَّحْمَـٰنِ الرَّحِيمِ"
        android:textColor="#22FFFFFF"
        android:textSize="13sp" />

    <!-- Center group: glass card + Takbeer -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:gravity="center"
        android:orientation="vertical"
        android:paddingStart="28dp"
        android:paddingEnd="28dp">

        <!-- Glass card -->
        <LinearLayout
            android:id="@+id/center_layout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_glass_card"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingStart="32dp"
            android:paddingEnd="32dp"
            android:paddingTop="40dp"
            android:paddingBottom="40dp">

            <!-- Label -->
            <TextView
                android:id="@+id/tv_athan_call"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/ibm_plex_sans_arabic"
                android:letterSpacing="0.14"
                android:text="حَانَ وَقْتُ أَذَان"
                android:textAllCaps="false"
                android:textColor="#662DD4A0"
                android:textSize="12sp" />

            <!-- Prayer name — heavy weight -->
            <TextView
                android:id="@+id/tv_prayer_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:fontFamily="@font/ibm_plex_sans_arabic_bold"
                android:letterSpacing="0.0"
                android:text="صلاة المغرب"
                android:textColor="#F5F5F5"
                android:textSize="48sp" />

            <!-- Teal accent divider -->
            <View
                android:layout_width="56dp"
                android:layout_height="1dp"
                android:layout_marginTop="22dp"
                android:background="@drawable/divider_teal" />

            <!-- Time — teal accent, light weight -->
            <TextView
                android:id="@+id/tv_prayer_time"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:fontFamily="@font/ibm_plex_sans_arabic"
                android:letterSpacing="0.06"
                android:text="06:15 م"
                android:textColor="#2DD4A0"
                android:textSize="28sp" />

        </LinearLayout>

        <!-- Takbeer — below card, barely visible -->
        <TextView
            android:id="@+id/tv_takbeer"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:fontFamily="@font/ibm_plex_sans_arabic"
            android:letterSpacing="0.1"
            android:text="اللهُ أَكْبَرُ"
            android:textColor="#1A2DD4A0"
            android:textSize="13sp" />

    </LinearLayout>

    <!-- Bottom block -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginBottom="52dp"
        android:gravity="center"
        android:orientation="vertical"
        android:paddingStart="36dp"
        android:paddingEnd="36dp">

        <!-- Modern pill stop button -->
        <Button
            android:id="@+id/btn_stop_adhan"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:background="@drawable/btn_stop_adhan"
            android:elevation="4dp"
            android:fontFamily="@font/ibm_plex_sans_arabic_bold"
            android:letterSpacing="0.04"
            android:text="إيقاف الأذان"
            android:textAllCaps="false"
            android:textColor="#FFFFFF"
            android:textSize="16sp" />

        <!-- Hint -->
        <TextView
            android:id="@+id/tv_unlock_hint"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:fontFamily="@font/ibm_plex_sans_arabic"
            android:letterSpacing="0.05"
            android:text="أو اضغط زرّ خفض الصوت"
            android:textColor="#22FFFFFF"
            android:textSize="12sp" />

    </LinearLayout>

</FrameLayout>
